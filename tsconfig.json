{
  "compilerOptions": {
    // This is for root only, so no compilation happens here
    "noEmit": true,

    "lib": ["ES2024"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "strict": true
  },
  // include root files (with and without a dot prefix)
  // also include the roots of packages to allow importing from each other
  "include": ["./*", "./.*", "./packages/*/*", "./packages/*/.*"]
}
