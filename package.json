{
  "name": "ilmercatinodellibro-monorepo",
  "version": "0.3.0",
  "repository": "https://github.com/ilmercatinodellibro/ilmercatinodellibro",
  "private": true,
  "license": "MIT",
  "author": "Dreamonkey Srl <info@dreamonkey.com> (https://dreamonkey.com)",
  "contributors": [
    "Paolo Caleffi <p.caleffi@dreamonkey.com>",
    "Francesco Bonacini <f.bonacini@dreamonkey.com>",
    "Alessandro Vandelli <a.vandelli@dreamonkey.com>"
  ],
  "description": "Il Mercatino del Libro monorepo",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scriptsComments": {
    "clean": "pnpm has a built-in `clean` command that deletes node_modules. Which one `pnpm clean` runs has changed between pnpm versions (pnpm 11 runs the built-in for `pnpm --filter <selector> clean`), so the script is always invoked with an explicit `run`."
  },
  "scripts": {
    "clean": "pnpm --filter \"./packages/**\" run clean",
    "generate": "pnpm --filter \"./packages/server\" generate && pnpm --filter \"./packages/client\" generate",
    "lint:root": "eslint --cache --fix --report-unused-disable-directives",
    "lint": "pnpm lint:root && pnpm --filter \"./packages/**\" lint",
    "format:root": "prettier --write \"**/*.{json,md,graphql,vue,js,ts,yml}\" \"!packages/**\" --ignore-path .gitignore",
    "format": "pnpm format:root && pnpm --filter \"./packages/**\" format",
    "client:build": "pnpm --filter \"./packages/client\" build:pwa",
    "server:build": "pnpm --filter \"./packages/server\" build",
    "build": "pnpm run clean && pnpm generate && pnpm client:build && pnpm server:build",
    "serve": "pnpm --filter \"./packages/server\" start:prod",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "client:dev": "pnpm --filter \"./packages/client\" dev",
    "server:dev": "pnpm --filter \"./packages/server\" dev",
    "server:migrate:reset": "pnpm --filter \"./packages/server\" migrate:reset",
    "docker:start": "pnpm --filter \"./packages/server\" docker:start",
    "docker:stop": "pnpm --filter \"./packages/server\" docker:stop",
    "db:start": "pnpm --filter \"./packages/server\" db:start",
    "db:stop": "pnpm --filter \"./packages/server\" db:stop",
    "backup:db": "pnpm --filter \"./packages/server\" backup:db",
    "backup:app": "pnpm --filter \"./packages/server\" backup:app",
    "restore:db": "pnpm --filter \"./packages/server\" restore:db",
    "restore:app": "pnpm --filter \"./packages/server\" restore:app",
    "backup:sync": "pnpm --filter \"./packages/server\" backup:sync",
    "backup:alpine": "pnpm --filter \"./packages/server\" backup:alpine",
    "restore:db:list": "pnpm --filter \"./packages/server\" restore:db:list",
    "restore:app:list": "pnpm --filter \"./packages/server\" restore:app:list",
    "prepare": "husky && pnpm generate",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@cspell/dict-it-it": "^3.1.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-coralloy": "^0.8.1",
    "graphql-config": "^5.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-coralloy": "^0.5.2",
    "typescript": "~5.9.3"
  },
  "overridesComments": {
    "vite": "Manually added while we wait for Quasar app-vite to catch up: https://github.com/quasarframework/quasar/issues/14077",
    "@vitejs/plugin-vue": "Manually added while we wait for Quasar app-vite to catch up: https://github.com/quasarframework/quasar/issues/14077"
  },
  "patchesComments": {
    "@nestjs-modules/mailer": "Allows to use Nodemailer plugins by exposing the transporters. See https://github.com/nest-modules/mailer/issues/1171#issuecomment-2141411992"
  },
  "engines": {
    "node": "^24.22.3",
    "pnpm": "^12"
  }
}
