{
  "name": "@ilmercatinodellibro/server",
  "version": "0.3.0",
  "description": "",
  "author": "Dreamonkey Srl <info@dreamonkey.com> (https://dreamonkey.com)",
  "contributors": [
    "Francesco Bonacini <f.bonacini@dreamonkey.com>",
    "Paolo Caleffi <p.caleffi@dreamonkey.com>",
    "Alessandro Vandelli <a.vandelli@dreamonkey.com>"
  ],
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rimraf dist && rimraf client-dist && rimraf src/@generated",
    "build": "nest build",
    "add-admin": "node dist/src/commander add-admin",
    "import:books": "node dist/src/commander import",
    "import:schools": "node dist/src/commander import --school",
    "seed-users-with-books": "node dist/src/commander seed-users-with-books",
    "seed-users-with-books:clear": "node dist/src/commander seed-users-with-books --clear",
    "lint": "eslint --cache --fix --report-unused-disable-directives",
    "format": "prettier --write \"**/*.{js,ts,graphql,md,json,yml,prisma}\" --ignore-path .gitignore",
    "start": "nest start",
    "start:repl": "pnpm run start --entryFile repl",
    "dev": "pnpm run start:dev",
    "generate:graphql": "pnpm run run-ts ./src/generate.ts",
    "generate:prisma": "prisma generate",
    "generate": "pnpm run generate:prisma && pnpm run generate:graphql",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset -f && pnpm db:seed",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "serve": "pnpm run start:prod",
    "db": "docker compose up",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:seed": "prisma db seed",
    "db:psql": "docker exec -it ilmercatinodellibro-postgres psql -U postgres -d postgres",
    "backup:db": "docker exec ilmercatinodellibro-backup /scripts/backup_db.sh",
    "backup:app": "docker exec ilmercatinodellibro-backup /scripts/backup_app.sh",
    "backup:sync": "docker exec ilmercatinodellibro-backup /scripts/sync.sh",
    "backup:alpine": "docker exec -it ilmercatinodellibro-backup sh",
    "restore:db:list": "docker exec -it ilmercatinodellibro-backup ls /backups | grep db_backup",
    "restore:app:list": "docker exec -it ilmercatinodellibro-backup ls /backups | grep app_backup",
    "restore:db": "docker exec -it ilmercatinodellibro-backup /scripts/restore_db.sh",
    "restore:app": "docker exec -it ilmercatinodellibro-backup /scripts/restore_app.sh",
    "queue:cli": "docker exec -it ilmercatinodellibro-redis redis-cli",
    "queue:flush": "pnpm run queue:cli FLUSHDB",
    "queue:list": "pnpm run queue:cli --scan",
    "queue:show": "pnpm run queue:cli HGETALL",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "run-ts": "node -r tsconfig-paths/register -r ts-node/register"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@getbrevo/brevo": "^2.2.0",
    "@nestjs-modules/mailer": "1.9.1",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/serve-static": "^12.1.1",
    "@pdfme/common": "^6.0.6",
    "@pdfme/generator": "^6.0.6",
    "@pdfme/schemas": "^6.0.6",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.31.1",
    "async": "^3.2.4",
    "bullmq": "^4.12.5",
    "csv": "^6.3.5",
    "dotenv": "catalog:",
    "ejs": "^3.1.9",
    "firebase-admin": "^11.11.0",
    "graphql": "catalog:",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "catalog:",
    "html-to-text": "^9.0.5",
    "lodash": "catalog:",
    "nest-commander": "^3.21.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.6.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "dependencyComments": {
    "undici": "Node 18+ uses undici for its fetch implementation, but without shipping appropriate types. Volar pick up DOM typings for server workspace too making things worse. We resolved to use undici fetch as a separate package for now, to avoid TS errors during the compilation"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/async": "^3.2.24",
    "@types/ejs": "^3.1.2",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "catalog:",
    "@types/multer": "^1.4.11",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.12",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^2.0.16",
    "class-transformer": "^0.5.1",
    "dotenv-expand": "catalog:",
    "fast-glob": "catalog:",
    "graphql-scalars": "^1.23.0",
    "jest": "28.1.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "~7.10.1",
    "prisma-nestjs-graphql": "^21.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "undici": "^5.28.4",
    "zod": "^3.22.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
