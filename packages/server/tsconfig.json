{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "src/*": ["./src/*"],
      "prisma/*": ["./prisma/*"],
      "test/*": ["./test/*"]
    },

    // Resolving/transpiling related options
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Avoid cross-os errors due to inconsistent file casing
    "forceConsistentCasingInFileNames": true,

    // Multer augments the Express namespace, so it must be loaded as a global type
    "types": ["node", "multer"],

    // Nest-JS related options
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,

    // Checks
    "noUnusedLocals": true,

    // Output related options
    // Keeps the dist/src layout that start:prod relies on
    // Since Nest CLI v12 assets keep their path relative to rootDir, so their outDir in nest-cli.json is dist/
    "rootDir": "./",
    "outDir": "./dist",
    "incremental": true,
    "sourceMap": true,
    "declaration": true,
    "removeComments": true
  }
}
