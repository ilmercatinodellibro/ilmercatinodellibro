{
  "name": "@ilmercatinodellibro/client",
  "version": "0.3.0",
  "description": "Il Mercatino del Libro webapp",
  "productName": "Il Mercatino del Libro",
  "author": "Dreamonkey Srl <info@dreamonkey.com> (https://dreamonkey.com)",
  "private": true,
  "scripts": {
    "icons:generate": "pnpm dlx @quasar/icongenie g -i src/assets/favicon-reggio-emilia.png --skip-trim",
    "clean": "quasar clean && rimraf src/@generated **.graphql.ts",
    "lint:script": "eslint --cache --fix --report-unused-disable-directives",
    "lint:style": "stylelint --cache \"**/*.{css,scss,vue}\" --fix --report-needless-disables",
    "lint": "pnpm lint:script && pnpm lint:style",
    "format": "prettier --write \"**/*.{json,md,graphql,vue,js,ts,yml}\" --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit --project tsconfig.vue-tsc.json",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "concurrently --raw --passthrough-arguments \"quasar dev {@}\" \"pnpm:generate:watch\" --",
    "dev:pwa": "pnpm dev -m pwa",
    "build": "quasar build",
    "build:pwa": "pnpm build -m pwa",
    "build:pwa:hot-swap": "cross-env BUILD_WITH_HOT_SWAP='true' pnpm run build:pwa",
    "serve": "./node_modules/@quasar/cli/bin/quasar.js serve ../server/client-dist/ --history",
    "start": "pnpm build && pnpm serve",
    "generate": "graphql-codegen --config codegen.ts",
    "generate:watch": "pnpm generate --watch"
  },
  "overridesComments": {
    "_root": "See root package.json => overridesComments for more info."
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@quasar/extras": "^1.16.11",
    "@vue/apollo-composable": "^4.0.2",
    "@vueuse/components": "^10.9.0",
    "@vueuse/core": "^10.9.0",
    "dotenv": "catalog:",
    "dotenv-expand": "catalog:",
    "echarts": "^5.5.1",
    "firebase": "^10.10.0",
    "graphql": "catalog:",
    "graphql-ws": "catalog:",
    "jwt-decode": "^3.1.2",
    "lodash-es": "^4.17.21",
    "quasar": "^2.15.2",
    "register-service-worker": "^1.7.2",
    "vue": "^3.4.19",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^9.9.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@dreamonkey/graphql-codegen-near-operation-file": "^0.1.2",
    "@dreamonkey/graphql-codegen-vue-apollo-plugin": "^0.1.2",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/near-operation-file-preset": "^3.0.0",
    "@graphql-codegen/typescript-apollo-client-helpers": "^3.0.0",
    "@parcel/watcher": "^2.4.1",
    "@quasar/app-vite": "^1.8.0",
    "@quasar/cli": "^2.4.0",
    "@quasar/quasar-app-extension-apollo": "^2.2.4",
    "@types/lodash-es": "^4.17.12",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "fast-glob": "catalog:",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^2.2.10",
    "workbox-build": "^7.0.0",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  }
}
